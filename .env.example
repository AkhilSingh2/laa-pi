# Never put job-portal passwords here. Portal logins happen manually, once, inside the persistent browser profile
# at data/browser_profile/ (Settings > Connections > Log in).

# Optional: the AI key can also be set in Settings > AI (stored in data/secrets.json).
# Use one of these, and pick the matching provider in Settings > AI.
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...                 # DeepSeek direct, model deepseek-chat
# TM_API_KEY=tm_vk_...                    # RouterPlus; can call DeepSeek and other models
# LLM_API_KEY=...                         # any other OpenAI-compatible API (set its base URL in Settings)

# Docker only (docker compose reads this file): password for the dashboard and the browser view.
# APP_PASSWORD=choose-a-strong-password
# APP_USER=laa
# HOST_PORT=8080
